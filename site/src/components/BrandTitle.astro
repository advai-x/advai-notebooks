---
import { Image } from 'astro:assets';
import lightMark from '../assets/notebook-mark-light.png';
import darkMark from '../assets/notebook-mark-dark.png';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title brand-title" aria-label={siteTitle} translate="no">
  <Image class="brand-mark brand-mark-light" src={lightMark} alt="" aria-hidden="true" width={80} height={80} format="webp" quality={95} loading="eager" />
  <Image class="brand-mark brand-mark-dark" src={darkMark} alt="" aria-hidden="true" width={80} height={80} format="webp" quality={95} loading="eager" />
  <span class="brand-name"><strong>advai</strong><span>-notebooks</span></span>
</a>
