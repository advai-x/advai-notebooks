{
  "name": "advai-notebooks-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "overrides": { "postcss-selector-parser": "7.1.6" },
  "scripts": {
    "dev": "npm run sync-docs && astro dev --host 127.0.0.1",
    "sync-docs": "node scripts/sync-content.mjs",
    "check": "node --test tests/*.test.mjs",
    "build": "npm run sync-docs && astro build && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "cheerio": "^1.1.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  }
}
